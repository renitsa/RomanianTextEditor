{
  "CONSOLE_LEVEL": "INFO",
  "FILE_LEVEL": "DEBUG",
  "LOG_TO_FILE": true,
  "LOG_TO_CONSOLE": true,
  "MAX_LOG_FILES": 10,
  "LOG_FILE_MAX_SIZE_MB": 50,
  "USE_SINGLE_LOG_FILE": true,
  "SINGLE_LOG_FILE_NAME": "application.log",
  "CONSOLE_FORMAT": "%(levelname)s: %(message)s",
  "LOG_FORMAT": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
  "DATE_FORMAT": "%Y-%m-%d %H:%M:%S"
}